# Model Provider Configuration
# Choose 'ollama' for local development (free, private) or 'gemini'/'openai' for cloud
MODEL_PROVIDER=ollama

# Ollama Configuration (for local usage)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# Ollama Configuration (for cloud usage)
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=your-ollama-api-key-here

# Google Gemini Configuration (for cloud usage)
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash  # Default

# OpenAI Configuration (for cloud usage)
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o  # Default

# Supabase Configuration (required)
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Native PostgreSQL Connection (required for Data Engineer Agent)
# Get from Supabase Dashboard > Settings > Database > Connection string > Direct
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# MLflow Configuration (observability)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=Personal Finance Assistant
